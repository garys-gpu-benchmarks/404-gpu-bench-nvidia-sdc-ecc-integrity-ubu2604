  {
    "field_name": "Repo Name",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "gpu-bench-nvidia-sdc-ecc-integrity-ubu2604"
  },
  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Analyze ECC memory integrity via a CUDA fixed-pattern verifier"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates that ecc_walk completes with a loops= line and reports ECC text counts plus pass rate. DCGM memory diagnostics are not run"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: Uncorrected ECC errors (uncorrected_ecc_errors_count); #2: Corrected ECC errors (corrected_ecc_errors_count); #3: Wall-clock time, s (test_wall_clock_completion_time_s); #4: Device buffer size, GiB (hbm3_coverage_gb); #5: Fixed-pattern fill/verify pass rate (walking_1s_moving_inversion_pass_rate)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/ecc_walk.cu with nvcc; run bin/ecc_walk; query nvidia-smi -q -d ECC"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/ecc_walk.cu with nvcc and run bin/ecc_walk over a cudaMalloc buffer with two fixed fills (0x00000001 and 0xFFFFFFFF) until yaml num_iterations or duration, then count Correctable/Uncorrectable tokens from nvidia-smi -q -d ECC, to measure SDC pass rate and ECC text hits. DCGM is not called"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/ecc_walk.cu and run bin/ecc_walk, writing and verifying fills 0x00000001 and 0xFFFFFFFF until the iteration or duration cap, then count Correctable and Uncorrectable tokens from nvidia-smi -q -d ECC. DCGM is not called"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Builds and runs bin/ecc_walk from src/ecc_walk.cu to walk a cudaMalloc buffer and query nvidia-smi ECC text. device_id: CUDA device index. memory_size: allocation size in GB. num_iterations: verify loops. duration: wall-clock cap (collector converts ms yaml values to seconds). pattern_type is documented but the binary alternates 0x1 / 0xFFFFFFFF. ecc_check reads nvidia-smi -q -d ECC; DCGM is not used. count and seed are yaml fields. output_format: csv"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validation / Correctness"
  },
  {
    "field_name": "Workload Category",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "System Validation & Reliability"
  },
