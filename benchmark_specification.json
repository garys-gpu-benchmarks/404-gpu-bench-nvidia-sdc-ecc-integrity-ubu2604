    "value": "H100 SXM 80GB"
  },
  {
    "field_name": "Raw Output Format",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CSV aggregate of the ECC walk, written as sample_index 0 and 1"
  },
  {
    "field_name": "Primary Record Granularity",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "one aggregate row, written twice"
  },
  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,status,uncorrected_ecc_errors_count,corrected_ecc_errors_count,uncorrected_ecc_aggregate_count,corrected_ecc_aggregate_count,uncorrected_ecc_nonzero_field_count,corrected_ecc_nonzero_field_count,hbm3_coverage_gb,walking_1s_moving_inversion_pass_rate,test_wall_clock_completion_time_s,error_message\n0,ok,0,0,0,0,0,0,1.0,100,2.0,"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --memory-size 1 --pattern-type walking-1s --ecc-check true --num-iterations 2 --output-format csv --duration 20000 --count 1 --seed 0"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --memory-size 1 --pattern-type walking-1s --ecc-check true --num-iterations 3 --output-format csv --duration 183000 --count 1 --seed 0"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --device-id 0 --memory-size 1 --pattern-type walking-1s --ecc-check true --num-iterations 9 --output-format csv --duration 730000 --count 1 --seed 0"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "uncorrected_ecc_errors_count, corrected_ecc_errors_count, uncorrected_ecc_aggregate_count, corrected_ecc_aggregate_count, uncorrected_ecc_nonzero_field_count, corrected_ecc_nonzero_field_count, hbm3_coverage_gb, walking_1s_moving_inversion_pass_rate, test_wall_clock_completion_time_s"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bin/ecc_walk prints a loops= line, and the uncorrected-ECC delta and pass-rate gates pass"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Corrected and uncorrected ECC are nvidia-smi -q -d ECC counter deltas (after minus before), not text-hit counts. The walk pass rate comes from loops and failed_loops. The aggregate row is written twice"
  },
